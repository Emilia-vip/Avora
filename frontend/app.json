{
  "expo": {
    "name": "Avora",
    "slug": "Avora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4F0",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
  "expo-router",
  "expo-font",
  "expo-image",
  "expo-status-bar",
  "expo-web-browser",
  [
    "expo-splash-screen",
    {
      "backgroundColor": "#F7F4F0",
        "ios": {
          "image": "./assets/images/Avora logga.jpg",
        "imageWidth": 280,
        "resizeMode": "contain"
        },
      "android": {
        "image": "./assets/images/Avora logga.jpg",
        "imageWidth": 280,
        "resizeMode": "contain"
      }
    }
  ],
  "expo-secure-store",
  [
    "expo-location",
    {
      "locationWhenInUsePermission": "Avora uses your location to match looks to the weather."
    }
  ],
  [
    "expo-image-picker",
    {
      "cameraPermission": "Avora uses the camera to photograph your clothes.",
      "photosPermission": "Avora uses your photos so you can add pictures of your clothes."
    }
  ]
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
